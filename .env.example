# Copia este archivo como ".env" y reemplaza los marcadores con tu configuracion.
# El archivo .env real contiene secretos y no debe subirse a Git.

# Clave de la API de Groq. Pega aqui tu clave localmente; no la compartas ni la subas.
GROQ_API_KEY=pega_aqui_tu_clave

# Modelo de Groq que se usara. Consulta la consola de Groq para elegir uno vigente.
GROQ_MODEL=elige_un_modelo_vigente

# Tiempo maximo de espera de cada solicitud a la API, en segundos.
GROQ_TIMEOUT_SEGUNDOS=30

# Clave secreta usada por Flask para proteger sesiones y datos firmados.
FLASK_SECRET_KEY=pega_aqui_una_clave_secreta

# Opcional: ruta alternativa de la base de datos (por defecto data/bodega.db).
# BODEGA_DB_PATH=
